# ==============================================================================
# LLM-GraphRAG-KG Environment Configuration Template
# Copy this file to `.env` and fill in your own credentials.
# NEVER commit `.env` or real API keys to GitHub.
# ==============================================================================

# --- LLM Provider ---
# Supported values: "openai_compat" (cloud API or local Magpie/Ollama/vLLM) | "mock" (offline demo)
GRAPHRAG_LLM_PROVIDER=openai_compat

# OpenAI-compatible API endpoint.
# Examples:
#   - Local Magpie / Ollama / vLLM: http://127.0.0.1:<port>/v1
#   - DeepSeek:                     https://api.deepseek.com/v1
#   - OpenAI:                       https://api.openai.com/v1
GRAPHRAG_LLM_BASE_URL=http://127.0.0.1:11434/v1

# API key (for local endpoints that do not require auth, you can use "local-no-key")
GRAPHRAG_LLM_API_KEY=your-api-key-here

# Chat / completion model identifier exposed by your endpoint
GRAPHRAG_LLM_MODEL=qwen2.5:7b

# Optional request timeout (seconds)
GRAPHRAG_LLM_TIMEOUT=60

# --- Embedding Provider ---
# Supported values: "openai_compat" | "local_hash" (offline zero-dependency fallback)
GRAPHRAG_EMBEDDING_PROVIDER=local_hash

# Only required when GRAPHRAG_EMBEDDING_PROVIDER=openai_compat
GRAPHRAG_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
GRAPHRAG_EMBEDDING_API_KEY=your-api-key-here
GRAPHRAG_EMBEDDING_MODEL=nomic-embed-text
