# ==============================================================================
# LLM-GraphRAG-KG Environment Configuration Template
# Copy this file to `.env` and fill in your own credentials.
# NEVER commit `.env` or real API keys to GitHub.
# ==============================================================================

# --- LLM Provider ---
# Supported values: "ollama_native" (recommended for local Ollama) | "openai_compat" (cloud API / vLLM) | "mock"
GRAPHRAG_LLM_PROVIDER=ollama_native

# Endpoint URL:
#   - Local Ollama native / compat: http://127.0.0.1:11434 (or .../v1)
#   - Local vLLM / LM Studio:       http://127.0.0.1:<port>/v1
#   - DeepSeek / OpenAI:            https://api.deepseek.com/v1 | https://api.openai.com/v1
GRAPHRAG_LLM_BASE_URL=http://127.0.0.1:11434

# API key (for local endpoints that do not require auth, you can use "local-no-key")
GRAPHRAG_LLM_API_KEY=your-api-key-here

# Stage 3 foundational local model (8 GB VRAM recommended):
#   - qwen3.5:9b  : Primary GraphRAG / reasoning base model (~49-54 tok/s @ 8k-32k with num_gpu=99)
#   - qwen3.5:4b  : Fast offline KG extraction / query routing tier (~70-89 tok/s, 3.8-4.7 GiB VRAM)
#   - gemma4:12b  : Optional reference model (requires >=12 GB VRAM for full GPU; DO NOT set num_gpu=99 on 8 GB cards)
GRAPHRAG_LLM_MODEL=qwen3.5:9b

# Optional request timeout (seconds)
GRAPHRAG_LLM_TIMEOUT=180

# Ollama native controls (see docs/benchmark_stage3_base_model.md):
#   - GRAPHRAG_LLM_THINK=false   : Disable implicit thinking channel for structured KG/RAG/CoT/ToT
#   - GRAPHRAG_LLM_NUM_CTX=16384 : Recommended online RAG window (use 4096-8192 for bulk extraction, max 32768 on 8 GB)
#   - GRAPHRAG_LLM_NUM_GPU=99    : Force full GPU offload for qwen3.5:9b / qwen3.5:4b (1.36x-2.55x faster @ 16k-32k);
#                                  LEAVE UNSET when using models whose weights exceed physical VRAM (e.g. gemma4:12b on 8 GB).
GRAPHRAG_LLM_THINK=false
GRAPHRAG_LLM_NUM_CTX=16384
GRAPHRAG_LLM_NUM_GPU=99

# Optional Dual-Model Tiering for Iterative Graph-CoT v2 (`cot_iter`) & Multi-Depth Graph-ToT v2 (`tot_bfs`/`tot_dfs`):
#   - Leave unset on single 8 GB GPUs during interactive QA to avoid ~7-11s per-query VRAM swap overhead.
#   - Set to `qwen3.5:4b` on >=12-16 GB VRAM (dual-resident), cloud APIs, or two-stage batch pipelines for 15%-24% net compute speedup.
# GRAPHRAG_LLM_FAST_MODEL=qwen3.5:4b
# GRAPHRAG_LLM_FAST_NUM_CTX=8192

# --- Embedding Provider ---
# Supported values: "ollama_native" (recommended local dense) | "openai_compat" | "local_hash" (offline fallback)
GRAPHRAG_EMBEDDING_PROVIDER=ollama_native

# Endpoint URL & model (for local Ollama dense embeddings, pull first: `ollama pull nomic-embed-text`):
#   - nomic-embed-text : ~400 MiB VRAM, 768-dim, coexists cleanly with qwen3.5:9b @ 16k on 8 GB VRAM
#   - bge-m3           : ~1.2 GiB VRAM, 1024-dim multilingual (set GRAPHRAG_EMBEDDING_NUM_GPU=0 on 8 GB cards during online QA)
GRAPHRAG_EMBEDDING_BASE_URL=http://127.0.0.1:11434
GRAPHRAG_EMBEDDING_API_KEY=your-api-key-here
GRAPHRAG_EMBEDDING_MODEL=nomic-embed-text
GRAPHRAG_EMBEDDING_BATCH_SIZE=32
# Optional: set 0 to pin embedding inference to CPU when coexisting with large LLMs on 8 GB VRAM
# GRAPHRAG_EMBEDDING_NUM_GPU=0
